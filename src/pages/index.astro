---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import { mediaFor, mediaSummary } from '../lib/photos';

const hotels = (await getCollection('hotels', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));
---
<Base>
  <section class="intro">
    <h1>{site.tagline}</h1>
  </section>

  <ul class:list={["hotels", { few: hotels.length <= 2 }]}>
    {hotels.map((h, i) => (
      <li>
        <a href={`/hotels/${h.id}/`} class="card">
          <div class="frame">
            <Image
              src={h.data.cover}
              alt={`${h.data.name}, ${h.data.location}`}
              widths={[480, 800, 1200]}
              sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
              loading={i < 3 ? 'eager' : 'lazy'}
            />
          </div>
          <div class="meta">
            <h2>{h.data.name}</h2>
            <p class="eyebrow">{h.data.location} · {mediaSummary(mediaFor(h.id))}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .intro { padding: 48px var(--gutter) 56px; max-width: 900px; }
  .intro h1 { font-size: clamp(34px, 5.5vw, 64px); font-style: italic; }
  .hotels {
    list-style: none; margin: 0; padding: 0 var(--gutter);
    display: grid; gap: 48px 28px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
  /* With only one or two hotels, let the cards fill the width in a wider frame. */
  .hotels.few { grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
  .hotels.few .frame { aspect-ratio: 4 / 3; }
  .card { display: block; text-decoration: none; }
  .frame { aspect-ratio: 4 / 5; overflow: hidden; background: var(--surface); }
  .frame img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform .8s cubic-bezier(.2,.7,.2,1), opacity .4s;
  }
  .card:hover .frame img { transform: scale(1.04); }
  .meta { padding-top: 16px; }
  .meta h2 { font-size: 28px; }
  .meta p { margin: 6px 0 0; }
</style>
