---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---
<Base title="About">
  <section class="about">
    <p class="eyebrow">About</p>
    <h1>{site.photographer}</h1>
    <div class="copy">
      <p>
        I photograph hotels — the rooms, the light and the small details that make a place feel lived in.
        Replace this text in <code>src/pages/about.astro</code> with your own story: who you are,
        who you've worked with and what kind of projects you take on.
      </p>
      <p>For commissions and enquiries:</p>
      <p class="contact">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {site.instagram && <a href={site.instagram} rel="noopener">Instagram</a>}
      </p>
    </div>
  </section>
</Base>

<style>
  .about { padding: 48px var(--gutter); max-width: 720px; }
  h1 { font-size: clamp(40px, 6vw, 72px); margin: 12px 0 32px; }
  .copy { font-size: 17px; color: #cfc8c0; }
  .contact { display: flex; gap: 24px; flex-wrap: wrap; font-family: var(--serif); font-size: 26px; }
  .contact a { text-decoration-color: var(--accent); text-underline-offset: 6px; text-decoration-thickness: 1px; }
  code { font-size: 14px; color: var(--accent); }
</style>
