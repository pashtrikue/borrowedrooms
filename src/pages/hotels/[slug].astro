---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Lightbox from '../../components/Lightbox.astro';
import { photosFor } from '../../lib/photos';

export async function getStaticPaths() {
  const hotels = (await getCollection('hotels', ({ data }) => !data.draft))
    .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));
  return hotels.map((hotel, i) => ({
    params: { slug: hotel.id },
    props: { hotel, next: hotels[(i + 1) % hotels.length] },
  }));
}

const { hotel, next } = Astro.props;
const { Content } = await render(hotel);
const photos = await Promise.all(
  photosFor(hotel.id).map(async ({ image }, i) => {
    const full = await getImage({ src: image, width: Math.min(image.width, 2400), format: 'webp' });
    return { image, full: full.src, alt: `${hotel.data.name} — photo ${i + 1}` };
  }),
);
---
<Base title={hotel.data.name} description={`${hotel.data.name}, ${hotel.data.location}`}>
  <article>
    <header class="hotel-head">
      <a href="/" class="back eyebrow">← All hotels</a>
      <h1>{hotel.data.name}</h1>
      <p class="eyebrow">
        {hotel.data.location}{hotel.data.year && <> · {hotel.data.year}</>} · {photos.length} photos
      </p>
      <div class="desc"><Content /></div>
    </header>

    <div class="gallery">
      {photos.map((p, i) => (
        <a href={p.full} class="photo" data-index={i} data-full={p.full}>
          <Image
            src={p.image}
            alt={p.alt}
            widths={[480, 800, 1200]}
            sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
            loading={i < 4 ? 'eager' : 'lazy'}
          />
        </a>
      ))}
    </div>

    {next.id !== hotel.id && (
      <a href={`/hotels/${next.id}/`} class="next">
        <span class="eyebrow">Next hotel</span>
        <span class="next-name">{next.data.name} →</span>
      </a>
    )}
  </article>

  <Lightbox />
</Base>

<style>
  .hotel-head { padding: 32px var(--gutter) 56px; max-width: 760px; }
  .back { text-decoration: none; display: inline-block; margin-bottom: 28px; }
  .back:hover { color: var(--text); }
  h1 { font-size: clamp(44px, 7vw, 88px); margin-bottom: 14px; }
  .desc { font-size: 17px; color: #cfc8c0; margin-top: 24px; }
  .gallery { columns: 3 320px; column-gap: 16px; padding: 0 var(--gutter); }
  .photo {
    display: block; margin-bottom: 16px; break-inside: avoid;
    background: var(--surface); cursor: zoom-in; overflow: hidden;
  }
  .photo img { width: 100%; transition: opacity .3s, transform .8s cubic-bezier(.2,.7,.2,1); }
  .photo:hover img { opacity: .88; }
  .next {
    display: flex; flex-direction: column; gap: 8px; text-decoration: none;
    margin: 80px var(--gutter) 0; padding-top: 32px; border-top: 1px solid var(--line);
  }
  .next-name { font-family: var(--serif); font-size: clamp(30px, 4vw, 48px); }
  .next:hover .next-name { color: var(--accent); }
</style>
