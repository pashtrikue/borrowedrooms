---
// Full-screen viewer for photos and videos.
// Works with any <a class="photo" data-full="..." data-kind="image|video"> on the page.
---
<dialog class="lightbox" aria-label="Photo viewer">
  <img class="lb-img" alt="" />
  <video class="lb-video" controls playsinline loop hidden></video>
  <button class="lb-close" aria-label="Close">×</button>
  <button class="lb-prev" aria-label="Previous">‹</button>
  <button class="lb-next" aria-label="Next">›</button>
  <p class="lb-count eyebrow"></p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dialog.querySelector<HTMLImageElement>('.lb-img')!;
  const video = dialog.querySelector<HTMLVideoElement>('.lb-video')!;
  const count = dialog.querySelector<HTMLElement>('.lb-count')!;
  // Sorted by data-index so the order survives the gallery's column layout.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a.photo')].sort(
    (a, b) => Number(a.dataset.index) - Number(b.dataset.index),
  );
  let current = 0;

  function show(i: number) {
    current = (i + links.length) % links.length;
    const link = links[current];
    const isVideo = link.dataset.kind === 'video';
    img.hidden = isVideo;
    video.hidden = !isVideo;
    if (isVideo) {
      img.removeAttribute('src');
      video.poster = link.dataset.poster ?? '';
      video.src = link.dataset.full!;
      video.muted = true;
      video.play().catch(() => {});
    } else {
      video.pause();
      video.removeAttribute('src');
      video.load();
      img.src = link.dataset.full!;
      img.alt = link.querySelector('img')?.alt ?? '';
    }
    count.textContent = `${current + 1} / ${links.length}`;
    // Preload neighbouring photos for smooth stepping.
    for (const d of [1, -1]) {
      const n = links[(current + d + links.length) % links.length];
      if (n.dataset.kind !== 'video') new Image().src = n.dataset.full!;
    }
  }

  links.forEach((link, i) =>
    link.addEventListener('click', (e) => {
      e.preventDefault();
      show(i);
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    }),
  );

  dialog.addEventListener('close', () => {
    video.pause();
    document.body.style.overflow = '';
    links[current]?.focus();
  });
  dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('.lb-next')!.addEventListener('click', () => show(current + 1));
  // Click on the backdrop (not the photo) closes.
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  document.addEventListener('keydown', (e) => {
    if (!dialog.open) return;
    if (e.key === 'ArrowRight') show(current + 1);
    if (e.key === 'ArrowLeft') show(current - 1);
  });

  // Swipe on touch screens.
  let startX = 0;
  dialog.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
  dialog.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
  });
</script>

<style>
  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0; background: rgba(8, 7, 6, .96); color: var(--text);
  }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: rgba(8, 7, 6, .96); }
  .lb-img, .lb-video {
    grid-area: 1 / 1;
    max-width: calc(100vw - 140px); max-height: calc(100dvh - 100px);
    width: auto; height: auto; object-fit: contain; user-select: none;
  }
  [hidden] { display: none !important; }
  button {
    position: absolute; background: none; border: 0; color: var(--text); cursor: pointer;
    font-family: var(--serif); font-size: 48px; line-height: 1; padding: 12px 18px; opacity: .7;
  }
  button:hover { opacity: 1; }
  .lb-close { top: 8px; right: 8px; font-size: 40px; }
  .lb-prev { left: 4px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 4px; top: 50%; transform: translateY(-50%); }
  .lb-count { position: absolute; bottom: 12px; left: 0; right: 0; text-align: center; margin: 0; }
  @media (max-width: 700px) {
    .lb-img, .lb-video { max-width: 100vw; max-height: calc(100dvh - 120px); }
    .lb-prev, .lb-next { top: auto; bottom: 0; transform: none; }
  }
</style>
